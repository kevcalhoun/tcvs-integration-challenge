# Shopify Configuration
# Get these from your Shopify Partners dev store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_from_shopify

# TecovaSuite Configuration
# Register at https://tecovasuite.tecovas.workers.dev to get your API key
TECOVASUITE_API_URL=https://tecovasuite.tecovas.workers.dev/api/v1
TECOVASUITE_API_KEY=tcs_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
